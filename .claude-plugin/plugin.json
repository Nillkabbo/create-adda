{
  "name": "adda",
  "version": "0.2.4",
  "description": "Talk to Claude in Banglish while everything it ships stays in English. Toggle with /adda on|off|status.",
  "author": {
    "name": "MD. RAKIBUL HASAN",
    "url": "https://github.com/Nillkabbo"
  },
  "homepage": "https://github.com/Nillkabbo/create-adda",
  "repository": "https://github.com/Nillkabbo/create-adda",
  "license": "MIT",
  "keywords": [
    "adda",
    "banglish",
    "bengali",
    "language",
    "bilingual"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs\"",
            "timeout": 5,
            "statusMessage": "Loading Adda..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/prompt-submit.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
